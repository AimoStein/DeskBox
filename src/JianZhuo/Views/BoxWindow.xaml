<Window x:Class="JianZhuo.Views.BoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Title="简桌盒子"
        Width="360"
        Height="300">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="IconPanel">
            <WrapPanel Orientation="Horizontal" IsItemsHost="True" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel Orientation="Vertical" IsItemsHost="True" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="IconItemTemplate">
            <Border x:Name="Host" Width="{Binding ItemWidth}" Background="Transparent" CornerRadius="7"
                    Margin="1" Padding="4,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,6,0,0" MaxHeight="30"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Host" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate">
            <Border x:Name="Host" Background="Transparent" CornerRadius="6" Margin="0,1" Padding="6,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="9,0,8,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Host" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Outer" Margin="12">
        <!-- 背景层：透明度可调 -->
        <Border x:Name="Backdrop" CornerRadius="10" Background="{DynamicResource BoxBgBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- 内容层 -->
        <Border x:Name="Frame" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource BoxBorderBrush}" Background="Transparent">
            <Grid x:Name="FrameGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleRow" Height="34" />
                    <RowDefinition x:Name="ContentRow" Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CollapseButton" Grid.Column="0" Style="{StaticResource IconButton}"
                            Margin="7,0,0,0" Click="Collapse_Click" ToolTip="收起 / 展开">
                        <Path x:Name="CollapseArrow" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              Data="M0,0 L4.5,4.5 L9,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>

                    <Grid Grid.Column="1" Margin="6,0,4,0">
                        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" Cursor="SizeAll"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox x:Name="TitleBox" Style="{StaticResource FlatTextBox}" Visibility="Collapsed"
                                 Padding="6,2" FontSize="12.5" KeyDown="TitleBox_KeyDown"
                                 LostFocus="TitleBox_LostFocus" />
                    </Grid>

                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Opacity="0"
                                Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="ViewButton" Style="{StaticResource IconButton}" Click="View_Click"
                                ToolTip="切换图标 / 列表">
                            <Path x:Name="ViewIcon" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3"
                                  Data="M0,0 H4.5 V4.5 H0 Z M7,0 H11.5 V4.5 H7 Z M0,7 H4.5 V11.5 H0 Z M7,7 H11.5 V11.5 H7 Z"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button x:Name="LockButton" Style="{StaticResource IconButton}" Click="Lock_Click"
                                ToolTip="锁定位置">
                            <Grid Width="14" Height="14">
                                <Path x:Name="LockShackle" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.4" Data="M4.2,6.2 V4.4 A2.8,2.8 0 0 1 9.8,4.4 V6.2"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <Path x:Name="LockBody" Fill="{DynamicResource TextSecondaryBrush}"
                                      Data="M3.4,6.2 H10.6 A1.2,1.2 0 0 1 11.8,7.4 V11.4 A1.2,1.2 0 0 1 10.6,12.6 H3.4 A1.2,1.2 0 0 1 2.2,11.4 V7.4 A1.2,1.2 0 0 1 3.4,6.2 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                            </Grid>
                        </Button>
                        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Click="Menu_Click"
                                ToolTip="更多">
                            <Path Fill="{DynamicResource TextSecondaryBrush}"
                                  Data="M0,2 A1.6,1.6 0 1 1 3.2,2 A1.6,1.6 0 1 1 0,2 M5.4,2 A1.6,1.6 0 1 1 8.6,2 A1.6,1.6 0 1 1 5.4,2 M10.8,2 A1.6,1.6 0 1 1 14,2 A1.6,1.6 0 1 1 10.8,2"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容区 -->
                <Grid Grid.Row="1" Margin="6,0,4,6">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,2,0,2">
                        <ItemsControl x:Name="ItemsHost" Background="Transparent" />
                    </ScrollViewer>

                    <Grid x:Name="EmptyHint" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource HintBorderBrush}"
                                   StrokeThickness="1.2" StrokeDashArray="3 3" Margin="6,4,6,6" />
                        <TextBlock Text="把文件拖到这里" FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>

                    <Border x:Name="DropHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                            CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2" Margin="2" />
                </Grid>
            </Grid>
        </Border>

        <!-- 缩放热区 -->
        <Grid x:Name="ResizeLayer" Margin="-3">
            <Border Tag="L" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="Transparent" Cursor="SizeWE" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="R" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="Transparent" Cursor="SizeWE" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="T" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="Transparent" Cursor="SizeNS" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="B" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="Transparent" Cursor="SizeNS" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="TL" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="TR" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="BL" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Background="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
            <Border Tag="BR" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="Resize_MouseLeftButtonDown" />
        </Grid>
    </Grid>
</Window>
