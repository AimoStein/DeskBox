<Window x:Class="DeskBox.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="简桌 · 开始面板" Width="1100" Height="900" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="#FFF1F4F7">
    <Window.Resources>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelScrollBar" TargetType="ScrollBar">
            <Style.Resources>
                <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">36</sys:Double>
            </Style.Resources>
            <Setter Property="Width" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" Width="4" HorizontalAlignment="Center"
                                                        Background="#80CAD7E7" CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#BFADC4D5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Style.Resources>
                <SolidColorBrush x:Key="PanelButtonHoverBrush" Color="#20CCDDF2" />
            </Style.Resources>
            <Setter Property="Foreground" Value="#FFF1F4F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PanelButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="#A8BFD1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#54B5CDE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherTile" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF1F4F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#A8BFD1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="PanelRoot" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False">
        <Grid x:Name="Scene" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.08,0" EndPoint="0.94,1">
                    <GradientStop Color="#354355" Offset="0" />
                    <GradientStop Color="#293441" Offset="0.49" />
                    <GradientStop Color="#1D242F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Border BorderBrush="#48B4C1D2" BorderThickness="1" CornerRadius="24" IsHitTestVisible="False" />
        <Grid Margin="24,20,8,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,16,14">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="设置"
                        Margin="8,0,0,0" Background="#12DAE6F9" BorderBrush="#1FDAE6F9"
                        Style="{StaticResource PanelButton}" />
                <Button x:Name="AddGroup" DockPanel.Dock="Right" Content="＋ 新建分组"
                        Margin="8,0,0,0" Background="#12DAE6F9" BorderBrush="#1FDAE6F9"
                        AutomationProperties.Name="新建分组" Style="{StaticResource PanelButton}" />
                <Border Background="#34000000" BorderBrush="#2ADAE6F9" BorderThickness="1" CornerRadius="10" Height="44">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M 13,8 A 5,5 0 1 1 3,8 A 5,5 0 1 1 13,8 M 12,12 L 17,17"
                              Stroke="#C7D4DE" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0"
                              StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                              IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索应用、快捷方式或文件"
                                   TextTrimming="CharacterEllipsis" Foreground="#AFBBC9" FontSize="14"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="Search" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                                 CaretBrush="#ECF4FA" Foreground="#FFF1F4F7" FontSize="14" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="搜索应用、快捷方式或文件" />
                    </Grid>
                </Border>
            </DockPanel>
            <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False"
                          AutomationProperties.Name="分组和快捷方式">
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Margin="0,4"
                                       Style="{StaticResource PanelScrollBar}" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <StackPanel x:Name="Cards" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
