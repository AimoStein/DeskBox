<Window x:Class="DeskBox.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="简桌 · 开始面板" Width="1120" Height="630" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="#FFF1F4F7">
    <Window.Resources>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelScrollBar" TargetType="ScrollBar">
            <Style.Resources>
                <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">36</sys:Double>
            </Style.Resources>
            <Setter Property="Width" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" Width="4" HorizontalAlignment="Center"
                                                        Background="#80CAD7E7" CornerRadius="2" />
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                                        <Setter TargetName="Handle" Property="Width" Value="Auto" />
                                                        <Setter TargetName="Handle" Property="Height" Value="4" />
                                                        <Setter TargetName="Handle" Property="HorizontalAlignment" Value="Stretch" />
                                                        <Setter TargetName="Handle" Property="VerticalAlignment" Value="Center" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#BFADC4D5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GroupTitleGrip" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupCornerGrip" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path x:Name="Mark" Data="M 10,18 L 18,10 M 14,18 L 18,14" Stroke="#789DABBA"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Mark" Property="Stroke" Value="#FFE0ECFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="SearchIcon">M 10,3.5 A 6.5,6.5 0 1 0 10,16.5 A 6.5,6.5 0 1 0 10,3.5 M 15,15 L 20.5,20.5</Geometry>
        <Geometry x:Key="AddGroupIcon">M 4,20.5 L 4,3.5 L 21,3.5 L 21,20.5 Z M 8,12 L 17,12 M 12.5,7.5 L 12.5,16.5</Geometry>
        <Geometry x:Key="TaskManagerIcon">M 3.5,4.5 H 21 V 19.5 H 3.5 Z M 6.5,15 L 10,11 L 13,13.5 L 17.5,8.5</Geometry>
        <Geometry x:Key="RegistryEditorIcon">M 3.5,10 H 9 V 15.5 H 3.5 Z M 3.5,15.5 H 9 V 21 H 3.5 Z M 9,15.5 H 14.5 V 21 H 9 Z M 10.5,8.5 H 16 V 14 H 10.5 Z M 16.5,3 H 22 V 8.5 H 16.5 Z</Geometry>
        <Geometry x:Key="ExplorerIcon">M 3,19.5 V 5.5 H 9.5 L 12,8 H 21 V 19.5 Z M 3,11 H 21</Geometry>
        <Geometry x:Key="DocumentsIcon">M 6,21 V 3 H 14 L 19,8 V 21 Z M 14,3 V 8 H 19 M 9,12 H 16 M 9,16 H 16</Geometry>
        <Geometry x:Key="DownloadsIcon">M 12,3.5 V 15 M 7.5,10.5 L 12,15 L 16.5,10.5 M 4.5,18 V 20.5 H 19.5 V 18</Geometry>
        <Geometry x:Key="DeskBoxSettingsIcon">M 3.5,6 H 9 M 13,6 H 20.5 M 9,3.5 V 8.5 M 3.5,12 H 15 M 19,12 H 20.5 M 15,9.5 V 14.5 M 3.5,18 H 7 M 11,18 H 20.5 M 7,15.5 V 20.5</Geometry>
        <Geometry x:Key="WindowsSettingsIcon">M 9.5,3.5 H 14.5 L 15,6.2 L 17,7.4 L 19.6,6.5 L 22,10.7 L 19.9,12.5 V 14.8 L 22,16.4 L 19.6,20.5 L 17,19.7 L 15,20.8 L 14.5,23 H 9.5 L 9,20.8 L 7,19.7 L 4.4,20.5 L 2,16.4 L 4.1,14.8 V 12.5 L 2,10.7 L 4.4,6.5 L 7,7.4 L 9,6.2 Z M 12,10 A 3.5,3.5 0 1 0 12,17 A 3.5,3.5 0 1 0 12,10</Geometry>
        <Geometry x:Key="InstalledAppsIcon">M 4,4 H 10 V 10 H 4 Z M 14,4 H 20 V 10 H 14 Z M 4,14 H 10 V 20 H 4 Z M 14,14 H 20 V 20 H 14 Z</Geometry>
        <Geometry x:Key="SleepIcon">M 13,3 C 7.5,3 3.5,7.4 3.5,12.5 C 3.5,17.6 7.6,21.5 12.5,21.5 C 16.7,21.5 20.2,18.8 21.5,15 C 16,16.8 10.5,12.7 10.5,7.4 C 10.5,5.7 11.3,4.1 13,3 Z</Geometry>
        <Geometry x:Key="RestartIcon">M 4.2,10 A 8,8 0 1 1 4.8,16 M 4.2,5.5 V 10 H 8.7</Geometry>
        <Geometry x:Key="ShutDownIcon">M 12,3 V 11 M 7,6.8 A 8,8 0 1 0 17,6.8</Geometry>
        <DataTemplate x:Key="ToolbarIcon">
            <Image Source="{Binding}" Width="20" Height="20" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </DataTemplate>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Style.Resources>
                <SolidColorBrush x:Key="PanelButtonHoverBrush" Color="#20CCDDF2" />
            </Style.Resources>
            <Setter Property="Foreground" Value="#FFF1F4F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ContentTemplate" Value="{StaticResource ToolbarIcon}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource PanelButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="#A8BFD1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#54B5CDE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherTile" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF1F4F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#A8BFD1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="PanelRoot" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False">
        <Grid x:Name="Scene" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.08,0" EndPoint="0.94,1">
                    <GradientStop Color="#354355" Offset="0" />
                    <GradientStop Color="#293441" Offset="0.49" />
                    <GradientStop Color="#1D242F" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Border BorderBrush="#48B4C1D2" BorderThickness="1" CornerRadius="24" IsHitTestVisible="False" />
        <Grid Margin="24,20,8,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False"
                          AutomationProperties.Name="分组和快捷方式">
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Margin="0,4"
                                       Style="{StaticResource PanelScrollBar}" Opacity="0" IsHitTestVisible="False"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <StackPanel x:Name="Cards" HorizontalAlignment="Left" />
            </ScrollViewer>
            <Canvas x:Name="GroupDragOverlay" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="GroupDragOutline" Visibility="Collapsed" BorderBrush="#FFA5D5FF"
                        BorderThickness="2" CornerRadius="14" Background="#308CBFFF">
                    <Border Background="#ED26394A" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="9,7,0,0" Padding="8,4">
                        <TextBlock x:Name="GroupDragCaption" Foreground="#FFF1F4F7" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Border>
            </Canvas>
            <Viewbox Grid.Row="1" Height="40" Margin="0,12,16,0" HorizontalAlignment="Center" StretchDirection="DownOnly">
                <StackPanel x:Name="Toolbar" Orientation="Horizontal"
                            KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
                    </StackPanel.Resources>
                    <Button x:Name="SearchButton" Content="{StaticResource SearchIcon}" ToolTip="搜索" />
                    <Border x:Name="SearchBox" Width="0" Height="34" Opacity="0" IsHitTestVisible="False"
                            Background="#34000000" BorderBrush="#2ADAE6F9" BorderThickness="1" CornerRadius="8"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Grid Margin="10,0">
                            <TextBlock x:Name="SearchHint" Text="搜索应用、快捷方式或文件"
                                       TextTrimming="CharacterEllipsis" Foreground="#AFBBC9" FontSize="13"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="Search" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="0"
                                     CaretBrush="#ECF4FA" Foreground="#FFF1F4F7" FontSize="13" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="搜索应用、快捷方式或文件" />
                        </Grid>
                    </Border>
                    <Button x:Name="AddGroup" Content="{StaticResource AddGroupIcon}" ToolTip="新建分组" />
                    <Button x:Name="SettingsButton" Content="{StaticResource DeskBoxSettingsIcon}" ToolTip="简桌设置" />
                    <Button x:Name="TaskManagerButton" Content="{StaticResource TaskManagerIcon}" ToolTip="任务管理器"
                            Margin="26,0,2,0" />
                    <Button x:Name="RegistryEditorButton" Content="{StaticResource RegistryEditorIcon}" ToolTip="注册表编辑器" />
                    <Button x:Name="ExplorerButton" Content="{StaticResource ExplorerIcon}" ToolTip="文件资源管理器" />
                    <Button x:Name="DocumentsButton" Content="{StaticResource DocumentsIcon}" ToolTip="文档" />
                    <Button x:Name="DownloadsButton" Content="{StaticResource DownloadsIcon}" ToolTip="下载" />
                    <Button x:Name="WindowsSettingsButton" Content="{StaticResource WindowsSettingsIcon}" ToolTip="Windows 设置" />
                    <Button x:Name="InstalledAppsButton" Content="{StaticResource InstalledAppsIcon}" ToolTip="已安装的应用" />
                    <Button x:Name="SleepButton" Content="{StaticResource SleepIcon}" ToolTip="睡眠" />
                    <Button x:Name="RestartButton" Content="{StaticResource RestartIcon}" ToolTip="重启" />
                    <Button x:Name="ShutDownButton" Content="{StaticResource ShutDownIcon}" ToolTip="关机" />
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
