<Window x:Class="DeskBox.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="简桌 · 开始面板" Width="880" Height="972" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True"
        Foreground="#FFF1F4F7">
    <Window.Resources>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,1">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" Background="#708CA4B6" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Background" Value="#BFADC4D5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF1F4F7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#32B5CDE0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="#A8BFD1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#54B5CDE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="SceneHost" IsHitTestVisible="False">
            <Grid x:Name="Scene" ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0.12,0.04" EndPoint="0.87,0.96">
                        <GradientStop Color="#485764" Offset="0" />
                        <GradientStop Color="#303C48" Offset="0.49" />
                        <GradientStop Color="#1A222C" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Image x:Name="Still" Stretch="UniformToFill" />
                <MediaElement x:Name="Motion" Stretch="UniformToFill" IsMuted="True"
                              LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>
            <Grid x:Name="MainArea">
                <Grid x:Name="OverviewPanel">
                    <Canvas x:Name="Overview" />
                    <Canvas x:Name="OverviewSearch" />
                </Grid>
                <Grid x:Name="Detail" Visibility="Collapsed">
                    <Grid x:Name="DetailPlate" IsHitTestVisible="False" />
                    <DockPanel x:Name="DetailContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="SearchBar" DockPanel.Dock="Top" Background="#EA1C2630" BorderBrush="#8395A9B9"
                                BorderThickness="1" CornerRadius="21" Height="42" Margin="0,0,0,12">
                            <Grid Margin="16,0">
                                <TextBlock x:Name="SearchHint" Text="搜索应用、快捷方式或文件"
                                           Foreground="#BDC9D3" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="0"
                                         CaretBrush="#ECF4FA" Foreground="#FFF1F4F7" FontSize="14" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="搜索应用、快捷方式或文件" />
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="ItemsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,5,0" Focusable="False">
                            <StackPanel x:Name="Cards" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>
            <Grid x:Name="DockArea" Grid.Row="1" Margin="16,8,16,0">
                <Grid x:Name="DockPlate" IsHitTestVisible="False" />
                <Border BorderBrush="#997F94A5" BorderThickness="1" CornerRadius="22" IsHitTestVisible="False" />
                <DockPanel Margin="10,2">
                    <Button x:Name="UngroupedButton" DockPanel.Dock="Left" Content="未分组" Style="{StaticResource PanelButton}" />
                    <Button x:Name="Options" DockPanel.Dock="Right" Content="···" FontSize="18"
                            ToolTip="面板选项" AutomationProperties.Name="面板选项" Style="{StaticResource PanelButton}" />
                    <Button x:Name="AddGroup" DockPanel.Dock="Right" Content="＋" FontSize="16"
                            ToolTip="新建分组" AutomationProperties.Name="新建分组" Style="{StaticResource PanelButton}" />
                    <Button x:Name="AllApps" DockPanel.Dock="Right" Content="应用" ToolTip="已安装应用" Style="{StaticResource PanelButton}" />
                    <Button x:Name="Back" DockPanel.Dock="Right" Content="返回" Style="{StaticResource PanelButton}" />
                    <ScrollViewer x:Name="DockScroll" Background="Transparent" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" Focusable="False">
                        <StackPanel x:Name="DockIcons" Orientation="Horizontal" VerticalAlignment="Center" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
